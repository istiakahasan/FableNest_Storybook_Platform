generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  buildingNo  String
  city        String
  country     String
  firstName   String
  lastName    String
  phoneNumber String
  postCode    String
  state       String
  street      String
  userId      String   @unique @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // relations
  user        User     @relation(fields: [userId], references: [id])
}

model Book {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  characterAge      Int
  characterName     String
  coverImagePrompt  String?
  coverImageUrl     String?
  gender            Gender
  language          Language
  pageConnections   Json
  pdfUrl            String?
  reference_image_1 String?
  reference_image_2 String?
  reference_image_3 String?
  style             Style
  title             String
  status            BookStatus @default(DRAFT)
  isAutoGenerated   Boolean    @default(false)

  userId     String      @db.ObjectId
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // relations
  cartItems  CartItem[]
  pages      BookPage[]
  orderItems OrderItem[]
  user       User        @relation(fields: [userId], references: [id])
}

model BookPage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId      String   @db.ObjectId
  content     String
  fullPageUrl String?
  leftUrl     String?
  name        String
  prompt      String
  rightUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // relations
  book        Book     @relation(fields: [bookId], references: [id])
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  // relations
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId    String   @db.ObjectId
  cartId    String   @db.ObjectId
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // relations
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  discount        Float?      @default(0)
  orderStatus     OrderStatus @default(PENDING)
  promoCodeId     String?     @db.ObjectId
  shippingAddress Json?
  totalAmount     Float?
  userId          String      @db.ObjectId
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  // relations
  orderItem       OrderItem[]
  payment         Payment[]
  promoCode       PromoCode?  @relation(fields: [promoCodeId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  bookId   String @db.ObjectId
  orderId  String @db.ObjectId
  quantity Int    @default(1)
  // relations
  book     Book   @relation(fields: [bookId], references: [id])
  order    Order  @relation(fields: [orderId], references: [id])
}

model OTP {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  otpCode      String
  otpExpiresAt DateTime
  userId       String   @unique @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // relations
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, otpCode])
  @@index([otpExpiresAt])
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  amount          Float
  currency        Currency
  orderId         String        @db.ObjectId
  paymentStatus   PaymentStatus @default(PENDING)
  receiptURL      String?
  stripePaymentId String?       @unique
  userId          String        @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // relations
  order           Order         @relation(fields: [orderId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model StaticConfig {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  bookPrice    Float
  isActive     Boolean  @default(true)
  shippingCost Float
  supportMail  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PrivacyPolicy {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  features  String[]
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  discountValue Float
  endTime       DateTime
  isActive      Boolean  @default(true)
  minimumAmount Float
  startTime     DateTime
  totalUses     Int      @default(0)
  useLimit      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // relations
  orders        Order[]

  @@index([endTime])
}

model TermsCondition {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  features  String[]
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  email              String    @unique
  firstName          String
  isBlocked          Boolean   @default(false)
  lastName           String
  mustChangePassword Boolean   @default(false)
  password           String
  profileImage       String    @default("")
  role               UserRole  @default(USER)
  suspensionEnds     DateTime?
  suspensionStarts   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // relations
  address            Address?
  books              Book[]
  Cart               Cart?
  orders             Order[]
  otp                OTP?
  payments           Payment[]
}

model AutoGenerateSetting {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  isEnabled Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Currency {
  AUD // Australian Dollar
  BDT // Bangladeshi Taka
  CAD // Canadian Dollar
  CHF // Swiss Franc
  CNY // Chinese Yuan
  EUR // Euro
  GBP // British Pound
  INR // Indian Rupee
  JPY // Japanese Yen
  USD // US Dollar
}

enum Gender {
  Female
  Male
}

enum Language {
  ARABIC
  English
  FRENCH
  ITALIAN
  SPANISH
}

enum OrderStatus {
  PENDING
  FAILED
  PROCESSING
  REFUNDED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  COMPLETED
}

enum PaymentStatus {
  COMPLETED
  FAILED
  PENDING
}

enum Style {
  ANIME
  CHILDRENS_MANGA
  PIXER_3D
  SEMI_REALISTIC_CARTOON
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  USER
}

enum BookStatus {
  DRAFT
  PUBLISHED
}
